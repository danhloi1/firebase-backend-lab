rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Kiểm tra quyền Admin qua Custom Claims
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Kiểm tra tài khoản email trường (.edu.vn) đã xác minh
    function isVerifiedStudent() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@.*\\.edu\\.vn$');
    }

    // Bảng danh sách trường: ai cũng đọc được, chỉ Admin được sửa/xóa
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bảng đánh giá (reviews)
    match /reviews/{reviewId} {
      // Công khai chỉ đọc bài đã duyệt; Admin hoặc chính tác giả đọc được bài của mình
      allow read: if resource.data.status == 'approved'
                  || isAdmin()
                  || (request.auth != null && resource.data.authorUid == request.auth.uid);

      // Sinh viên email trường chỉ được tạo bài mới với trạng thái bắt buộc là 'pending'
      allow create: if isVerifiedStudent()
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.status == 'pending';

      // Chỉ Admin mới được duyệt/từ chối hoặc xóa
      allow update, delete: if isAdmin();
    }
  }
}